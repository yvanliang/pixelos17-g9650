     device/g9650/compat/g9650-boot-kmsg.rc:$(TARGET_COPY_OUT_SYSTEM)/etc/init/g9650-boot-kmsg.rc
 PRODUCT_SYSTEM_PROPERTIES += persist.sys.samsung.full_brightness=true
 
