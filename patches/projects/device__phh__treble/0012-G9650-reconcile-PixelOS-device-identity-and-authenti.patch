From 98dfe157f14f5740d028280b5239336eef11f316 Mon Sep 17 00:00:00 2001
From: yvanliang <yvan6liang@outlook.com>
Date: Fri, 9 Oct 2026 21:04:42 +0800
Subject: [PATCH 12/38] G9650: reconcile PixelOS device identity and
 authenticated ADB properties

---
 base.mk                       |  6 ++++-
 custom_g9650.mk               |  3 +++
 g9650/g9650-system.prop       | 51 +++++++++++++++++++++++++++++++++++
 g9650/g9650-system_ext.prop   | 12 +++++++++
 tdgsi_arm64_ab/BoardConfig.mk |  4 +++
 5 files changed, 75 insertions(+), 1 deletion(-)
 create mode 100644 g9650/g9650-system.prop
 create mode 100644 g9650/g9650-system_ext.prop

diff --git a/base.mk b/base.mk
index 06a3218..a9f2f73 100644
--- a/base.mk
+++ b/base.mk
@@ -33,10 +33,14 @@ PRODUCT_SYSTEM_DEFAULT_PROPERTIES += \
     ro.build.version.all_codenames=$(PLATFORM_VERSION_ALL_CODENAMES) \
     ro.build.version.release=$(PLATFORM_VERSION) \
     ro.build.version.security_patch=$(PLATFORM_SECURITY_PATCH) \
-    ro.adb.secure=0 \
     ro.logd.auditd=true \
     ro.logd.kernel=true \
 
+# Keep PixelOS's authenticated ADB policy for the G9650 product.
+ifneq ($(TARGET_PRODUCT),custom_g9650)
+PRODUCT_SYSTEM_DEFAULT_PROPERTIES += ro.adb.secure=0
+endif
+
 # Huawei HiSuite (also other OEM custom programs I guess) it's of no use in AOSP builds
 PRODUCT_SYSTEM_DEFAULT_PROPERTIES += \
     persist.sys.usb.config=adb \
diff --git a/custom_g9650.mk b/custom_g9650.mk
index 9973efe..6fb08c9 100644
--- a/custom_g9650.mk
+++ b/custom_g9650.mk
@@ -33,3 +33,6 @@ PRODUCT_MODULE_BUILD_FROM_SOURCE := true
 
 # Keep the existing Samsung boot chain; deliver only SYSTEM.
 PRODUCT_BUILD_VBMETA_IMAGE := false
+
+# PixelOS identity differs from the generic board directory.
+PRODUCT_BUILD_PROP_OVERRIDES += CustomDevice=g9650
diff --git a/g9650/g9650-system.prop b/g9650/g9650-system.prop
new file mode 100644
index 0000000..d20331e
--- /dev/null
+++ b/g9650/g9650-system.prop
@@ -0,0 +1,51 @@
+# G9650: ADB authentication comes from PixelOS/Lineage policy.
+#Some devices have sdcardfs kernel panicing on 8.0
+#Disable for everyone for the moment
+ro.sys.sdcardfs=0
+persist.sys.overlay.nightmode=true
+
+#Disable debugging strict mode toasts
+persist.sys.strictmode.disable=true
+persist.sys.phh.mainkeys=0
+
+fw.max_users=10
+persist.sys.max_profiles=10
+ro.boot.realme.lockstate=0
+
+#Fixes fingerprint unlock delay
+persist.wm.enable_remote_keyguard_animation=0
+
+# Enable support of one-handed mode
+ro.support_one_handed_mode=true
+
+# Set the Bluetooth Class of Device
+# Service Field: 0x5A -> 90
+#    Bit 17: Networking
+#    Bit 19: Capturing
+#    Bit 20: Object Transfer
+#    Bit 22: Telephony
+# MAJOR_CLASS: 0x02 -> 2 (Phone)
+# MINOR_CLASS: 0x0C -> 12 (Smart Phone)
+bluetooth.device.class_of_device=90,2,12
+
+# Enable system-side generic bluetooth audio HAL
+persist.bluetooth.system_audio_hal.enabled=true
+# Set commonly-supported Bluetooth profiles to enabled
+# TODO: Enable BLE Audio profiles on newer vendors
+bluetooth.profile.asha.central.enabled?=true
+bluetooth.profile.a2dp.source.enabled?=true
+bluetooth.profile.avrcp.target.enabled?=true
+bluetooth.profile.bas.client.enabled?=true
+bluetooth.profile.gatt.enabled?=true
+bluetooth.profile.hfp.ag.enabled?=true
+bluetooth.profile.hid.device.enabled?=true
+bluetooth.profile.hid.host.enabled?=true
+bluetooth.profile.map.server.enabled?=true
+bluetooth.profile.opp.enabled?=true
+bluetooth.profile.pan.nap.enabled?=true
+bluetooth.profile.pan.panu.enabled?=true
+bluetooth.profile.pbap.server.enabled?=true
+bluetooth.profile.sap.server.enabled?=true
+
+# Samsung vendors default to a Samsung-specific gadget for MTP. Set this to use AOSP's functionfs MTP
+vendor.usb.use_ffs_mtp=1
diff --git a/g9650/g9650-system_ext.prop b/g9650/g9650-system_ext.prop
new file mode 100644
index 0000000..f1a6f04
--- /dev/null
+++ b/g9650/g9650-system_ext.prop
@@ -0,0 +1,12 @@
+# G9650: ADB authentication comes from PixelOS/Lineage policy.
+# GSI always generate dex pre-opt in system image
+ro.cp_system_other_odex=0
+
+
+# GSI disables non-AOSP nnapi extensions on product partition
+ro.nnapi.extensions.deny_on_product=true
+
+# TODO(b/120679683): disable RescueParty before all problem apps solved
+persist.sys.disable_rescue=true
+
+ro.control_privapp_permissions=enforce
diff --git a/tdgsi_arm64_ab/BoardConfig.mk b/tdgsi_arm64_ab/BoardConfig.mk
index ee91797..ada02bb 100644
--- a/tdgsi_arm64_ab/BoardConfig.mk
+++ b/tdgsi_arm64_ab/BoardConfig.mk
@@ -13,3 +13,7 @@ TARGET_NO_KERNEL_IMAGE := true
 
 # Clear any dynamic reserve inherited from the generic board.
 BOARD_SYSTEMIMAGE_PARTITION_RESERVED_SIZE :=
+
+# G9650: preserve all generic properties except the unauthenticated ADB default.
+TARGET_SYSTEM_PROP := $(filter-out device/phh/treble/system.prop,$(TARGET_SYSTEM_PROP)) device/phh/treble/g9650/g9650-system.prop
+TARGET_SYSTEM_EXT_PROP := device/phh/treble/g9650/g9650-system_ext.prop
