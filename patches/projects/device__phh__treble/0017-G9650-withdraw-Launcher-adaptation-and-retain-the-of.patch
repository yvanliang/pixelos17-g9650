+++ b/custom_g9650.mk
@@ -43,5 +43,3 @@ PRODUCT_COPY_FILES += device/phh/treble/g9650/g9650-wifi-cache.rc:$(TARGET_COPY_
 # TARGET_SCREEN_DENSITY alone does not emit the runtime display property.
 PRODUCT_SYSTEM_PROPERTIES += ro.sf.lcd_density=560
 
