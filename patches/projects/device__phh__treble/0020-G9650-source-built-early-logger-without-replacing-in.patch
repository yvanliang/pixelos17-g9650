From 334f5db23d8b9990897ca092037bb60fe401bf4a Mon Sep 17 00:00:00 2001
From: yvanliang <yvan6liang@outlook.com>
Date: Sat, 10 Oct 2026 09:49:38 +0800
Subject: [PATCH 20/38] G9650: source-built early logger without replacing init

---
 custom_g9650.mk                        |   3 +
 g9650/early-debug/Android.bp           |  13 +++
 g9650/early-debug/g9650-early-trace.rc |  11 +++
 g9650/early-debug/g9650-init-trace.c   | 105 +++++++++++++++++++++++++
 4 files changed, 132 insertions(+)
 create mode 100644 g9650/early-debug/Android.bp
 create mode 100644 g9650/early-debug/g9650-early-trace.rc
 create mode 100644 g9650/early-debug/g9650-init-trace.c

diff --git a/custom_g9650.mk b/custom_g9650.mk
index 0893d23..5863047 100644
--- a/custom_g9650.mk
+++ b/custom_g9650.mk
@@ -43,3 +43,6 @@ PRODUCT_COPY_FILES += device/phh/treble/g9650/g9650-wifi-cache.rc:$(TARGET_COPY_
 # TARGET_SCREEN_DENSITY alone does not emit the runtime display property.
 PRODUCT_SYSTEM_PROPERTIES += ro.sf.lcd_density=560
 
+
+# Temporary early kernel diagnosis; original init stays intact.
+PRODUCT_PACKAGES += g9650-early-trace
diff --git a/g9650/early-debug/Android.bp b/g9650/early-debug/Android.bp
new file mode 100644
index 0000000..060a9ba
--- /dev/null
+++ b/g9650/early-debug/Android.bp
@@ -0,0 +1,13 @@
+cc_binary {
+    name: "g9650-early-trace",
+    srcs: ["g9650-init-trace.c"],
+    compile_multilib: "64",
+    system_shared_libs: [],
+    stl: "none",
+    nocrt: true,
+    static_executable: true,
+    cflags: ["-ffreestanding", "-fno-builtin", "-fno-stack-protector"],
+    ldflags: ["-Wl,-e,_start"],
+    sanitize: { never: true },
+    init_rc: ["g9650-early-trace.rc"],
+}
diff --git a/g9650/early-debug/g9650-early-trace.rc b/g9650/early-debug/g9650-early-trace.rc
new file mode 100644
index 0000000..b29954b
--- /dev/null
+++ b/g9650/early-debug/g9650-early-trace.rc
@@ -0,0 +1,11 @@
+# Temporary diagnosis after policy load, before post-fs-data.
+on early-init
+    start g9650-early-trace
+
+service g9650-early-trace /system/bin/g9650-early-trace --early-trace
+    disabled
+    oneshot
+    user root
+    group root shell log
+    seclabel u:r:su:s0
+    capabilities SYS_ADMIN SYSLOG MKNOD
diff --git a/g9650/early-debug/g9650-init-trace.c b/g9650/early-debug/g9650-init-trace.c
new file mode 100644
index 0000000..00d7117
--- /dev/null
+++ b/g9650/early-debug/g9650-init-trace.c
@@ -0,0 +1,105 @@
+/* Temporary G9650 boot diagnostics, no libc/APEX dependency.
+ * Fork one cache-backed kernel log reader before the original init starts.
+ * Keep all original argv/env and all original fatal/self-test behaviour.
+ * No changes to the parent mount namespace, BOOT, vendor or calibration.
+ */
+typedef unsigned long U;
+typedef long L;
+static L call(U n, U a, U b, U c, U d, U e, U f) {
+    register U x0 __asm__("x0") = a;
+    register U x1 __asm__("x1") = b;
+    register U x2 __asm__("x2") = c;
+    register U x3 __asm__("x3") = d;
+    register U x4 __asm__("x4") = e;
+    register U x5 __asm__("x5") = f;
+    register U x8 __asm__("x8") = n;
+    __asm__ volatile("svc #0" : "+r"(x0) : "r"(x1), "r"(x2), "r"(x3),
+                     "r"(x4), "r"(x5), "r"(x8) : "memory", "cc");
+    return (L)x0;
+}
+static U len(const char *s) { U n=0; while(s[n]) ++n; return n; }
+static int same(const char *a,const char *b) {
+    while(*a && *a==*b) {++a; ++b;} return *a==*b;
+}
+static L openfile(const char *s,U flags,U mode) {
+    return call(56,(U)-100,(U)s,flags,mode,0,0);
+}
+static void put(L fd,const char *s,U n) {
+    while(n) {L k=call(64,fd,(U)s,n,0,0,0); if(k<=0) break; s+=k; n-=k;}
+}
+static void pause20(void) {
+    L t[2]={0,20000000}; call(101,(U)t,0,0,0,0,0);
+}
+static void die(U code) {call(94,code,0,0,0,0,0); for(;;){} }
+static char buffer[65536];
+static void capture(int snapshot,char **argv) {
+    if(!snapshot) {
+        /* Private mount namespace: init sees its original /cache and /dev. */
+        if(call(97,0x20000,0,0,0,0,0)<0) die(111);
+        if(call(40,0,(U)"/",0,0x40000|0x4000,0,0)<0) die(112);
+        L fd=openfile("/dev/kmsg",0x800,0);
+        if(fd<0) {
+            if(call(40,(U)"tmpfs",(U)"/dev",(U)"tmpfs",2,(U)"mode=0755",0)<0) die(113);
+            call(33,(U)-100,(U)"/dev/kmsg",0020000|0600,((U)1<<8)|11,0,0);
+        } else call(57,fd,0,0,0,0,0);
+        /* Extended partition minors differ between recovery and the normal
+         * kernel. Resolve sda25 from THIS boot's sysfs, never pin a minor. */
+        char device[64];
+        L desc=openfile("/sys/class/block/sda25/dev",0,0);
+        if(desc<0) die(117);
+        L count=call(63,desc,(U)device,sizeof(device),0,0,0);
+        call(57,desc,0,0,0,0,0);
+        if(count<=0) die(118);
+        U major=0,minor=0,at=0;
+        while(at<(U)count && device[at]>='0' && device[at]<='9') major=major*10+device[at++]-'0';
+        if(!at || at>=(U)count || device[at++]!=':') die(118);
+        U begin=at;
+        while(at<(U)count && device[at]>='0' && device[at]<='9') minor=minor*10+device[at++]-'0';
+        if(at==begin || (major!=259 && major!=8) || minor>1048575) die(119);
+        U dev=(minor&255)|((major&4095)<<8)|((minor&~255UL)<<12)|((major&~4095UL)<<32);
+        call(33,(U)-100,(U)"/dev/g9650-cache-log",0060000|0600,dev,0,0);
+        if(call(40,(U)"/dev/g9650-cache-log",(U)"/cache",(U)"ext4",2|4|1024,(U)"",0)<0) die(114);
+    }
+    L out=openfile(snapshot?"/cache/g9650-trace-probe.log":"/cache/g9650-early-kernel.log",
+                   1|64|1024|4096|524288,0600);
+    if(out<0) die(115);
+    const char *header="\n=== G9650 temporary init trace: original init preserved ===\n";
+    put(out,header,len(header));
+    for(U i=0;argv[i];i++) {put(out,argv[i],len(argv[i])); put(out," ",1);}
+    put(out,"\n",1); call(83,out,0,0,0,0,0);
+    L in=openfile("/dev/kmsg",0x800|524288,0);
+    if(in<0) {put(out,"cannot open /dev/kmsg\n",21); die(116);}
+    U bytes=0,idle=0,used=0;
+    while(bytes<16*1024*1024 && idle<30000) {
+        L n=call(63,in,(U)(buffer+used),sizeof(buffer)-used,0,0,0);
+        if(n>0) {
+            used+=n;
+            /* Batch records so a full boot ring is drained before a fast reboot. */
+            if(used>=32768) {put(out,buffer,used);bytes+=used;used=0;}
+        }
+        else if(n==-32) continue; /* Ring overrun: resume at next available record. */
+        else if(n==-11 || n==-4) {
+            if(used) {put(out,buffer,used);bytes+=used;used=0;}
+            if(snapshot) break; pause20(); ++idle;
+        }
+        else break;
+    }
+    if(used) put(out,buffer,used);
+    call(83,out,0,0,0,0,0); die(0);
+}
+__attribute__((used,noreturn)) void entry(U *stack) {
+    U argc=stack[0]; char **argv=(char **)(stack+1); char **env=argv+argc+1;
+    if(argc==2 && same(argv[1],"--probe")) capture(1,argv);
+    if(argc==2 && same(argv[1],"--early-trace")) capture(0,argv);
+    if(call(178,0,0,0,0,0,0)==1 && (argc==1 || same(argv[1],"selinux_setup"))) {
+        L child=call(220,17,0,0,0,0,0);
+        if(child==0) capture(0,argv);
+        /* Let the reader open cache before original init; no dependency on it. */
+        for(U i=0;i<5;i++) pause20();
+    }
+    call(221,(U)"/system/bin/g9650-init-real",(U)argv,(U)env,0,0,0);
+    die(127);
+}
+__attribute__((naked,noreturn)) void _start(void) {
+    __asm__ volatile("mov x0, sp\nbl entry\nmov x8, #94\nsvc #0");
+}
