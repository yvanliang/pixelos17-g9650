From 4c2c58884d6d4e9def08894222a38867bf7e781e Mon Sep 17 00:00:00 2001
From: yvanliang <42460514+yvanliang@users.noreply.github.com>
Date: Thu, 15 Oct 2026 20:39:48 +0800
Subject: [PATCH 36/38] G9650: mount charger GPU firmware and quiesce UI before
 reboot

---
 custom_g9650.mk                |  2 ++
 g9650/g9650-charger-log.sh     |  2 ++
 g9650/g9650-charger-quiesce.sh | 18 ++++++++++++++++++
 g9650/g9650-charger.rc         | 18 ++++++++++++++++++
 4 files changed, 40 insertions(+)
 create mode 100644 g9650/g9650-charger-quiesce.sh

diff --git a/custom_g9650.mk b/custom_g9650.mk
index f201138..a021acc 100644
--- a/custom_g9650.mk
+++ b/custom_g9650.mk
@@ -88,3 +88,5 @@ PRODUCT_DEX_PREOPT_BOOT_FLAGS += --runtime-arg -Xgc:CC
 PRODUCT_COPY_FILES += device/phh/treble/g9650/g9650-charger.rc:$(TARGET_COPY_OUT_SYSTEM)/etc/init/g9650-charger.rc
 
 PRODUCT_COPY_FILES += device/phh/treble/g9650/g9650-charger-log.sh:$(TARGET_COPY_OUT_SYSTEM)/bin/g9650-charger-log.sh
+
+PRODUCT_COPY_FILES += device/phh/treble/g9650/g9650-charger-quiesce.sh:$(TARGET_COPY_OUT_SYSTEM)/bin/g9650-charger-quiesce.sh
diff --git a/g9650/g9650-charger-log.sh b/g9650/g9650-charger-log.sh
index 14d5f50..1875a14 100644
--- a/g9650/g9650-charger-log.sh
+++ b/g9650/g9650-charger-log.sh
@@ -3,6 +3,8 @@ umask 077
 dir=/dev/g9650-charger-cache
 grep -q " $dir " /proc/mounts || exit 1
 {
+    grep -E "firmware_mnt|g9650-charger-cache" /proc/mounts
+    ls -l /vendor/firmware_mnt/image/a630_zap*
     echo "mode=$(getprop ro.bootmode) charger=$(pidof charger)"
     for pid in $(pidof charger); do grep -E '^(Name|Uid|Gid|Cap)' "/proc/$pid/status"; done
 } > "$dir/g9650-charger-environment.log"
diff --git a/g9650/g9650-charger-quiesce.sh b/g9650/g9650-charger-quiesce.sh
new file mode 100644
index 0000000..419b55b
--- /dev/null
+++ b/g9650/g9650-charger-quiesce.sh
@@ -0,0 +1,18 @@
+#!/system/bin/sh
+# Run synchronously from init's shutdown trigger, before its no-data fast path.
+log=/dev/g9650-charger-cache/g9650-charger-action.log
+printf '\nquiesce begin\n' >> "$log"
+n=0
+while pidof charger >/dev/null; do
+    n=$((n + 1))
+    [ "$n" -lt 50 ] || break
+    sleep 0.1
+done
+pids=$(pidof charger)
+printf 'quiesce remaining=%s polls=%s\n' "$pids" "$n" >> "$log"
+if [ -n "$pids" ]; then
+    for pid in $pids; do
+        cat "/proc/$pid/stack" >> "$log" 2>&1
+    done
+fi
+sync
diff --git a/g9650/g9650-charger.rc b/g9650/g9650-charger.rc
index 2e6ea83..e027997 100644
--- a/g9650/g9650-charger.rc
+++ b/g9650/g9650-charger.rc
@@ -6,6 +6,7 @@ on early-init && property:ro.bootmode=charger
 
 service g9650-charger /system/bin/charger
     class charger
+    disabled
     user system
     group system graphics input wakelock
     capabilities SYS_BOOT
@@ -13,12 +14,15 @@ service g9650-charger /system/bin/charger
 
 # Cache is unencrypted and available before charger-mode /data mounting.
 on charger
+    # Charger skips normal fs mounting; Adreno still needs its signed firmware.
+    mount vfat /dev/block/bootdevice/by-name/apnhlos /vendor/firmware_mnt ro nosuid nodev noexec context=u:object_r:firmware_file:s0,shortname=lower,uid=0,gid=1000,dmask=227,fmask=337
     mkdir /dev/g9650-charger-cache 0770 root system
     mount ext4 /dev/block/platform/soc/1d84000.ufshc/by-name/cache /dev/g9650-charger-cache nosuid nodev noexec
     write /dev/g9650-charger-cache/g9650-charger-action.log begin
     chown system system /dev/g9650-charger-cache/g9650-charger-action.log
     chmod 0600 /dev/g9650-charger-cache/g9650-charger-action.log
     start g9650-charger-log
+    start g9650-charger
 
 service g9650-charger-log /system/bin/sh /system/bin/g9650-charger-log.sh
     class charger
@@ -29,3 +33,17 @@ service g9650-charger-log /system/bin/sh /system/bin/g9650-charger-log.sh
     group root system cache log readproc
     capabilities SYSLOG
     seclabel u:r:init:s0
+
+# init's no-/data reboot fast path does not stop any services. Release the
+# charging DRM/input handles before the Samsung kernel starts its freeze pass.
+on shutdown && property:ro.bootmode=charger
+    stop g9650-charger
+    exec_start g9650-charger-quiesce
+
+service g9650-charger-quiesce /system/bin/sh /system/bin/g9650-charger-quiesce.sh
+    disabled
+    oneshot
+    timeout_period 8
+    user root
+    group root system cache log readproc
+    seclabel u:r:init:s0
