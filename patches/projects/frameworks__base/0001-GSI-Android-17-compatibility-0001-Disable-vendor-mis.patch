Subject: [PATCH 01/60] GSI Android 17 compatibility:
 0001-Disable-vendor-mismatch-warning.patch

Change-Id: Ia435c73844b6eff36d80004b789bd470694c6432
---
 .../server/wm/ActivityTaskManagerService.java      | 14 +-------------
 1 file changed, 1 insertion(+), 13 deletions(-)

diff --git a/services/core/java/com/android/server/wm/ActivityTaskManagerService.java b/services/core/java/com/android/server/wm/ActivityTaskManagerService.java
index 0a148b5e9..262156af2 100644
--- a/services/core/java/com/android/server/wm/ActivityTaskManagerService.java
+++ b/services/core/java/com/android/server/wm/ActivityTaskManagerService.java
@@ -7212,19 +7212,7 @@ public class ActivityTaskManagerService extends IActivityTaskManager.Stub {
 
                 if (!isBuildConsistent) {
                     Slog.e(TAG, "Build fingerprint is not consistent, warning user");
-                    mUiHandler.post(() -> {
-                        if (mShowDialogs) {
-                            AlertDialog d = new BaseErrorDialog(mUiContext);
-                            d.getWindow().setType(WindowManager.LayoutParams.TYPE_SYSTEM_ERROR);
-                            d.setCancelable(false);
-                            d.setTitle(mUiContext.getText(R.string.android_system_label));
-                            d.setMessage(mUiContext.getText(R.string.system_error_manufacturer));
-                            d.setButton(DialogInterface.BUTTON_POSITIVE,
-                                    mUiContext.getText(R.string.ok),
-                                    mUiHandler.obtainMessage(DISMISS_DIALOG_UI_MSG, d));
-                            d.show();
-                        }
-                    });
+                    // Do not emit warning about vendor mismatch
                 }
             }
             Trace.traceEnd(TRACE_TAG_WINDOW_MANAGER);
