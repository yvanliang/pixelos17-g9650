From b454c4df019969974fe92dfa81863d3c18eea2fd Mon Sep 17 00:00:00 2001
From: yvanliang <yvan6liang@outlook.com>
Date: Fri, 9 Oct 2026 15:41:37 +0800
Subject: [PATCH 34/60] GSI Android 17 compatibility:
 0036-Fix-brightness-slider-curve-for-some-devices.patch

Change-Id: I4a725f16937a8f247cf2d9e0957b07f8c86a0c34
---
 .../settingslib/display/BrightnessUtils.java       | 14 +++++++++++++-
 .../src/api/domain/model/GammaBrightness.kt        | 14 +++++++-------
 2 files changed, 20 insertions(+), 8 deletions(-)

diff --git a/packages/SettingsLib/DisplayUtils/src/com/android/settingslib/display/BrightnessUtils.java b/packages/SettingsLib/DisplayUtils/src/com/android/settingslib/display/BrightnessUtils.java
index 3c06f8ae9..204a738dd 100644
--- a/packages/SettingsLib/DisplayUtils/src/com/android/settingslib/display/BrightnessUtils.java
+++ b/packages/SettingsLib/DisplayUtils/src/com/android/settingslib/display/BrightnessUtils.java
@@ -19,14 +19,19 @@ package com.android.settingslib.display;
 import android.os.SystemProperties;
 import android.util.MathUtils;
 
+import com.android.internal.display.BrightnessSynchronizer;
+
 /** Utility methods for calculating the display brightness. */
 public class BrightnessUtils {
 
     public static final boolean sDisableGammaConversion =
             SystemProperties.getBoolean("sys.brightness.disable_gamma_conversion", false);
 
+    public static final boolean LowGammaBrightness = Boolean.parseBoolean(
+            SystemProperties.get("persist.sys.phh.low_gamma_brightness", "false"));
+
     public static final int GAMMA_SPACE_MIN = 0;
-    public static final int GAMMA_SPACE_MAX = 65535;
+    public static final int GAMMA_SPACE_MAX = LowGammaBrightness ? 255 : 65535;
 
     // Hybrid Log Gamma constant values
     private static final float R = 0.5f;
@@ -85,6 +90,10 @@ public class BrightnessUtils {
      * @return The corresponding setting value.
      */
     public static final float convertGammaToLinearFloat(int val, float min, float max) {
+        if (LowGammaBrightness) {
+            return MathUtils.constrain(BrightnessSynchronizer.brightnessIntToFloat(val),
+                    min, max);
+        }
         final float normalizedVal = MathUtils.norm(GAMMA_SPACE_MIN, GAMMA_SPACE_MAX, val);
 
         if (sDisableGammaConversion) {
@@ -142,6 +151,9 @@ public class BrightnessUtils {
      * @return The corresponding slider value
      */
     public static final int convertLinearToGammaFloat(float val, float min, float max) {
+        if (LowGammaBrightness) {
+            return BrightnessSynchronizer.brightnessFloatToInt(MathUtils.constrain(val, min, max));
+        }
         if (sDisableGammaConversion) {
             final float normalizedVal = MathUtils.norm(min, max, val);
             return Math.round(MathUtils.lerp(GAMMA_SPACE_MIN, GAMMA_SPACE_MAX, normalizedVal));
diff --git a/packages/SystemUI/pods/brightness/src/api/domain/model/GammaBrightness.kt b/packages/SystemUI/pods/brightness/src/api/domain/model/GammaBrightness.kt
index e52bb8745..82b9452a2 100644
--- a/packages/SystemUI/pods/brightness/src/api/domain/model/GammaBrightness.kt
+++ b/packages/SystemUI/pods/brightness/src/api/domain/model/GammaBrightness.kt
@@ -20,10 +20,10 @@ import androidx.annotation.IntRange
 import com.android.settingslib.display.BrightnessUtils
 
 @JvmInline
-public value class GammaBrightness(
-    @IntRange(
-        from = BrightnessUtils.GAMMA_SPACE_MIN.toLong(),
-        to = BrightnessUtils.GAMMA_SPACE_MAX.toLong(),
-    )
-    public val value: Int
-)
+value class GammaBrightness(val value: Int) {
+    init {
+        require(value == -1 || value in BrightnessUtils.GAMMA_SPACE_MIN..BrightnessUtils.GAMMA_SPACE_MAX) {
+            "Value must be in range ${BrightnessUtils.GAMMA_SPACE_MIN} to ${BrightnessUtils.GAMMA_SPACE_MAX}"
+        }
+    }
+}
