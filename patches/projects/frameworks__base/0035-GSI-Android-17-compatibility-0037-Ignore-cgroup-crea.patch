From 452d57d62c4a7c24b7adf825038e0a2a4b1e7b4d Mon Sep 17 00:00:00 2001
From: yvanliang <yvan6liang@outlook.com>
Date: Fri, 9 Oct 2026 15:41:40 +0800
Subject: [PATCH 35/60] GSI Android 17 compatibility:
 0037-Ignore-cgroup-creation-errors.patch

Change-Id: I01613acb79297d8c75c670948259d401966827ee
---
 core/jni/com_android_internal_os_Zygote.cpp               | 2 ++
 services/core/java/com/android/server/am/ProcessList.java | 4 ----
 2 files changed, 2 insertions(+), 4 deletions(-)

diff --git a/core/jni/com_android_internal_os_Zygote.cpp b/core/jni/com_android_internal_os_Zygote.cpp
index 15a7ee4a0..7f71adb8c 100644
--- a/core/jni/com_android_internal_os_Zygote.cpp
+++ b/core/jni/com_android_internal_os_Zygote.cpp
@@ -1985,10 +1985,12 @@ static void SpecializeCommon(JNIEnv* env, uid_t uid, gid_t gid, jintArray gids,
     if (getuid() == 0) {
         const int rc = createProcessGroup(uid, getpid());
         if (rc != 0) {
+#if 0
             fail_fn(rc == -EROFS ? CREATE_ERROR("createProcessGroup failed, kernel missing "
                                                 "CONFIG_CGROUP_CPUACCT?")
                                  : CREATE_ERROR("createProcessGroup(%d, %d) failed: %s", uid,
                                                 /* pid= */ 0, strerror(-rc)));
+#endif
         }
 
         if (is_system_server) {
diff --git a/services/core/java/com/android/server/am/ProcessList.java b/services/core/java/com/android/server/am/ProcessList.java
index d8e2cfaae..b3c1b3a27 100644
--- a/services/core/java/com/android/server/am/ProcessList.java
+++ b/services/core/java/com/android/server/am/ProcessList.java
@@ -2691,11 +2691,7 @@ public final class ProcessList extends ProcessListInternal
                             String errorStr = "Unable to create process group for "
                                 + app.processName + " (uid: " + uid + ", pid: " + startResult.pid
                                 + "), errno: " + res;
-                            if (res == -OsConstants.ESRCH) {
                                 Slog.e(ActivityManagerService.TAG, errorStr);
-                            } else {
-                                throw new AssertionError(errorStr);
-                            }
                         } else {
                             app.mProcessGroupCreated = true;
                         }
