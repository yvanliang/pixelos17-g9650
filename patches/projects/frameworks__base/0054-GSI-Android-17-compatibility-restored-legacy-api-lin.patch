From 729758855f36af636d07dd11e6174d7db3191e5f Mon Sep 17 00:00:00 2001
From: yvanliang <yvan6liang@outlook.com>
Date: Fri, 9 Oct 2026 22:50:32 +0800
Subject: [PATCH 54/60] GSI Android 17 compatibility:
 restored-legacy-api-lint.patch

Change-Id: Ia152275f7f8443dabb3787f6486b17989493d076
---
 core/java/android/os/storage/StorageManager.java       | 10 ++++++++++
 telephony/java/android/telephony/TelephonyManager.java | 10 ++++++++++
 2 files changed, 20 insertions(+)

diff --git a/core/java/android/os/storage/StorageManager.java b/core/java/android/os/storage/StorageManager.java
index d2591cc28..26f893b63 100644
--- a/core/java/android/os/storage/StorageManager.java
+++ b/core/java/android/os/storage/StorageManager.java
@@ -1718,6 +1718,8 @@ public class StorageManager {
      * @return true for encryptable or encrypted
      *         false not encrypted and not encryptable
      */
+    // Restored legacy compatibility API, not a new Android 17 feature.
+    @SuppressLint("UnflaggedApi")
     public static boolean isEncryptable() {
         return RoSystemProperties.CRYPTO_ENCRYPTABLE;
     }
@@ -1736,6 +1738,8 @@ public class StorageManager {
      * @return true for block encrypted. (Implies isEncrypted() == true)
      *         false not encrypted or file encrypted
      */
+    // Restored legacy compatibility API, not a new Android 17 feature.
+    @SuppressLint("UnflaggedApi")
     public static boolean isBlockEncrypted() {
         return false;
     }
@@ -1746,6 +1750,8 @@ public class StorageManager {
      *         (Implies isBlockEncrypted() == true)
      *         false not encrypted, file encrypted or default block encrypted
      */
+    // Restored legacy compatibility API, not a new Android 17 feature.
+    @SuppressLint("UnflaggedApi")
     public static boolean isNonDefaultBlockEncrypted() {
         return false;
     }
@@ -1760,6 +1766,8 @@ public class StorageManager {
      * Also note that this state will not change without a teardown of the
      * framework, so no service needs to check for changes during their lifespan
      */
+    // Restored legacy compatibility API, not a new Android 17 feature.
+    @SuppressLint("UnflaggedApi")
     public static boolean isBlockEncrypting() {
         return false;
     }
@@ -1775,6 +1783,8 @@ public class StorageManager {
      * Also note that this state will not change without a teardown of the
      * framework, so no service needs to check for changes during their lifespan
      */
+    // Restored legacy compatibility API, not a new Android 17 feature.
+    @SuppressLint("UnflaggedApi")
     public static boolean inCryptKeeperBounce() {
         return false;
     }
diff --git a/telephony/java/android/telephony/TelephonyManager.java b/telephony/java/android/telephony/TelephonyManager.java
index c9544b257..dfa23f427 100644
--- a/telephony/java/android/telephony/TelephonyManager.java
+++ b/telephony/java/android/telephony/TelephonyManager.java
@@ -3278,17 +3278,27 @@ public class TelephonyManager {
      * should be added after the current definitions.
      */
     /** Unknown network class. {@hide} */
+    // Restored legacy compatibility API, not a new Android 17 feature.
+    @SuppressLint("UnflaggedApi")
     public static final int NETWORK_CLASS_UNKNOWN = 0;
     /** Class of broadly defined "2G" networks. {@hide} */
     @UnsupportedAppUsage
+    // Restored legacy compatibility API, not a new Android 17 feature.
+    @SuppressLint("UnflaggedApi")
     public static final int NETWORK_CLASS_2_G = 1;
     /** Class of broadly defined "3G" networks. {@hide} */
     @UnsupportedAppUsage
+    // Restored legacy compatibility API, not a new Android 17 feature.
+    @SuppressLint("UnflaggedApi")
     public static final int NETWORK_CLASS_3_G = 2;
     /** Class of broadly defined "4G" networks. {@hide} */
     @UnsupportedAppUsage
+    // Restored legacy compatibility API, not a new Android 17 feature.
+    @SuppressLint("UnflaggedApi")
     public static final int NETWORK_CLASS_4_G = 3;
     /** Class of broadly defined "5G" networks. {@hide} */
+    // Restored legacy compatibility API, not a new Android 17 feature.
+    @SuppressLint("UnflaggedApi")
     public static final int NETWORK_CLASS_5_G = 4;
 
     /**
