From 191d1fd786ad1b56109d637427952921b6985de1 Mon Sep 17 00:00:00 2001
From: yvanliang <yvan6liang@outlook.com>
Date: Sat, 10 Oct 2026 11:06:53 +0800
Subject: [PATCH 55/60] G9650: select real legacy fingerprint HAL instead of
 virtual AIDL

Change-Id: I1ffaba6efaa1bc38293b7ab2cfae8d1b7d2a35dc
---
 .../server/biometrics/AuthService.java        | 23 ++++++++++++++++---
 1 file changed, 20 insertions(+), 3 deletions(-)

diff --git a/services/core/java/com/android/server/biometrics/AuthService.java b/services/core/java/com/android/server/biometrics/AuthService.java
index d5591d76b..39192ff9e 100644
--- a/services/core/java/com/android/server/biometrics/AuthService.java
+++ b/services/core/java/com/android/server/biometrics/AuthService.java
@@ -1168,8 +1168,15 @@ public class AuthService extends SystemService {
     private void registerAuthenticators() {
         BiometricHandlerProvider handlerProvider = mInjector.getBiometricHandlerProvider();
 
+        String[] fingerprintConfigs = mInjector.getFingerprintConfiguration(getContext());
+        // FVA4 declares a real HIDL 2.1 HAL but predates biometric resource configuration.
+        // Match the accepted Android 17 strategy only on this legacy Samsung product.
+        if ("g9650".equals(SystemProperties.get("ro.custom.device", ""))
+                && (fingerprintConfigs == null || fingerprintConfigs.length == 0)) {
+            fingerprintConfigs = generateRSdkCompatibleConfiguration();
+        }
         registerFingerprintSensors(mInjector.getFingerprintAidlInstances(),
-                mInjector.getFingerprintConfiguration(getContext()), getContext(),
+                fingerprintConfigs, getContext(),
                 mInjector.getFingerprintService(), handlerProvider);
         registerFaceSensors(mInjector.getFaceAidlInstances(),
                 mInjector.getFaceConfiguration(getContext()), getContext(),
@@ -1293,12 +1300,22 @@ public class AuthService extends SystemService {
             return;
         }
 
+        final boolean preferLegacyHidl =
+                "g9650".equals(SystemProperties.get("ro.custom.device", ""))
+                && !SystemProperties.getBoolean("persist.sys.phh.virtual_sensors_are_real", false)
+                && hidlConfigStrings != null && hidlConfigStrings.length > 0
+                && fingerprintAidlInstances != null && fingerprintAidlInstances.length == 1
+                && fingerprintAidlInstances[0].contains("virtual");
+        if (preferLegacyHidl) {
+            Slog.i(TAG, "G9650: selecting the physical HIDL fingerprint HAL over virtual AIDL");
+        }
         handlerProvider.getFingerprintHandler().post(() -> {
             final FingerprintSensorConfigurations mFingerprintSensorConfigurations =
                     new FingerprintSensorConfigurations(fingerprintAidlInstances != null
-                            && fingerprintAidlInstances.length > 0);
+                            && fingerprintAidlInstances.length > 0 && !preferLegacyHidl);
 
-            if (fingerprintAidlInstances != null && fingerprintAidlInstances.length > 0) {
+            if (fingerprintAidlInstances != null && fingerprintAidlInstances.length > 0
+                    && !preferLegacyHidl) {
                 mFingerprintSensorConfigurations.addAidlSensors(fingerprintAidlInstances);
             } else if (hidlConfigStrings != null && hidlConfigStrings.length > 0) {
                 mFingerprintSensorConfigurations.addHidlSensors(hidlConfigStrings, context);
