From 2acfe83d1c93fec4cb0b4264a267af17c0dc1159 Mon Sep 17 00:00:00 2001
From: yvanliang <yvan6liang@outlook.com>
Date: Fri, 9 Oct 2026 15:42:38 +0800
Subject: [PATCH 11/17] GSI Android 17 compatibility:
 0011-Increase-SW_MAX-4.patch

Change-Id: I7571833fd1cc7515f087c738da55d2641036efd9
---
 services/inputflinger/reader/EventHub.cpp       | 4 ++--
 services/inputflinger/reader/include/EventHub.h | 4 ++--
 2 files changed, 4 insertions(+), 4 deletions(-)

diff --git a/services/inputflinger/reader/EventHub.cpp b/services/inputflinger/reader/EventHub.cpp
index 30664ea..6e8c82a 100644
--- a/services/inputflinger/reader/EventHub.cpp
+++ b/services/inputflinger/reader/EventHub.cpp
@@ -1248,7 +1248,7 @@ int32_t EventHub::getKeyCodeForKeyLocation(RawDeviceId deviceId, int32_t locatio
 }
 
 int32_t EventHub::getSwitchState(RawDeviceId deviceId, int32_t sw) const {
-    if (sw < 0 || sw > SW_MAX) {
+    if (sw < 0 || sw > (SW_MAX * 4)) {
         return AKEY_STATE_UNKNOWN;
     }
     std::scoped_lock _l(mLock);
@@ -2657,7 +2657,7 @@ void EventHub::openDeviceLocked(const std::string& devicePath) {
     }
 
     // Check whether this device has switches.
-    for (int i = 0; i <= SW_MAX; i++) {
+    for (int i = 0; i <= (SW_MAX * 4); i++) {
         if (device->swBitmask.test(i)) {
             device->classes |= InputDeviceClass::SWITCH;
             break;
diff --git a/services/inputflinger/reader/include/EventHub.h b/services/inputflinger/reader/include/EventHub.h
index 83ff604..17600e2 100644
--- a/services/inputflinger/reader/include/EventHub.h
+++ b/services/inputflinger/reader/include/EventHub.h
@@ -659,8 +659,8 @@ private:
         BitArray<KEY_CNT> keyBitmask;
         BitArray<KEY_CNT> keyState;
         BitArray<REL_CNT> relBitmask;
-        BitArray<SW_CNT> swBitmask;
-        BitArray<SW_CNT> swState;
+        BitArray<SW_CNT * 4> swBitmask;
+        BitArray<SW_CNT * 4> swState;
         BitArray<LED_CNT> ledBitmask;
         BitArray<FF_CNT> ffBitmask;
         BitArray<INPUT_PROP_CNT> propBitmask;
