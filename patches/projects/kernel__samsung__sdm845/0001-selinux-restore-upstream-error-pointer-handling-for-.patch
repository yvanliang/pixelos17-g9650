From 3ef1563be5d696e2a3ac99cc3a3216408c521dd4 Mon Sep 17 00:00:00 2001
From: yvanliang <yvan6liang@outlook.com>
Date: Sat, 10 Oct 2026 10:02:17 +0800
Subject: [PATCH 1/2] selinux: restore upstream error-pointer handling for RCU
 inode permission

---
 security/selinux/hooks.c | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/security/selinux/hooks.c b/security/selinux/hooks.c
index 41d528b28b1c..0ecb1c0c1c75 100644
--- a/security/selinux/hooks.c
+++ b/security/selinux/hooks.c
@@ -3445,6 +3445,8 @@ static int selinux_inode_permission(struct inode *inode, int mask)
 
 	sid = cred_sid(cred);
 	isec = inode_security_rcu(inode, flags & MAY_NOT_BLOCK);
+	if (IS_ERR(isec))
+		return PTR_ERR(isec);
 
 	rc = avc_has_perm_noaudit(sid, isec->sid, isec->sclass, perms, 0, &avd);
 	audited = avc_audit_required(perms, &avd, rc,
