From d911628714535d38925ee0cca1b7f80c5b1b9c5e Mon Sep 17 00:00:00 2001
From: yvanliang <yvan6liang@outlook.com>
Date: Fri, 9 Oct 2026 16:56:41 +0800
Subject: [PATCH 9/9] GSI Android 17 compatibility:
 0001-bluetooth-legacy-controller-and-kernel-tolerance.patch

Change-Id: I419f3a4a164fb79de1998f2da9b26bee1f4e3d17
---
 system/gd/hci/hci_layer.cc                | 7 ++++++-
 system/gd/hci/le_scanning_manager_impl.cc | 2 +-
 2 files changed, 7 insertions(+), 2 deletions(-)

diff --git a/system/gd/hci/hci_layer.cc b/system/gd/hci/hci_layer.cc
index 6aebef4..7736b5f 100644
--- a/system/gd/hci/hci_layer.cc
+++ b/system/gd/hci/hci_layer.cc
@@ -263,11 +263,16 @@ struct HciLayer::impl {
     if ((is_vendor_specific && (is_status && waiting_for == WaitingFor::COMPLETE) &&
         (status_view.IsValid() && status_view.GetStatus() == ErrorCode::UNKNOWN_HCI_COMMAND)) ||
         ((is_status && waiting_for == WaitingFor::COMPLETE) &&
-        (status_view.IsValid() && status_view.GetStatus() == ErrorCode::UNSUPPORTED_REMOTE_OR_LMP_FEATURE))) {
+        (status_view.IsValid() && status_view.GetStatus() == ErrorCode::UNSUPPORTED_REMOTE_OR_LMP_FEATURE)) ||
+        (op_code == OpCode::SNIFF_SUBRATING && is_status && waiting_for == WaitingFor::COMPLETE)) {
       // If this is a command status of a vendor specific command, and command complete is expected,
       // we can't treat this as hard failure since we have no way of probing this lack of support at
       // earlier time. Instead we let the command complete handler handle a empty Command Complete
       // packet, which will be interpreted as invalid response.
+      //
+      // Some older controllers (e.g. MediaTek) answer the SNIFF_SUBRATING command with a status
+      // event when a command complete is expected. Treat that the same way to avoid aborting the
+      // Bluetooth stack during audio streaming.
 
       auto payload = std::make_unique<packet::RawBuilder>();
       payload->AddOctets1(static_cast<uint8_t>(status_view.GetStatus()));
diff --git a/system/gd/hci/le_scanning_manager_impl.cc b/system/gd/hci/le_scanning_manager_impl.cc
index f281c91..383fffa 100644
--- a/system/gd/hci/le_scanning_manager_impl.cc
+++ b/system/gd/hci/le_scanning_manager_impl.cc
@@ -205,7 +205,7 @@ struct LeScanningManagerImpl::impl : public LeAddressManagerCallback {
       api_type_ = ScanApiType::LEGACY;
     }
     is_filter_supported_ = controller_->IsSupported(OpCode::LE_ADV_FILTER);
-    if (os::GetSystemProperty(kPropertyDisableApcfExtendedFeatures) == "1")
+    if ((os::GetSystemProperty(kPropertyDisableApcfExtendedFeatures) == "1" || os::GetSystemProperty("persist.sys.bt.le.disable_apcf_extended_features") == "1"))
       kDisableApcfExtendedFeatures = true;
     if (is_filter_supported_ && !kDisableApcfExtendedFeatures) {
       le_scanning_interface_->EnqueueCommand(
