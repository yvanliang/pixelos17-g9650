From 20b6479c76225da22f10c293f435f247415f9fe3 Mon Sep 17 00:00:00 2001
From: yvanliang <yvan6liang@outlook.com>
Date: Fri, 9 Oct 2026 15:43:24 +0800
Subject: [PATCH 05/18] GSI Android 17 compatibility:
 0005-netd-Remove-4.14-kernel-restrictions.patch

Change-Id: I7a2790a52d5ada2477514e64e7ab9f50c6ef087a
---
 bpf/netd/BpfHandler.cpp | 10 ----------
 1 file changed, 10 deletions(-)

diff --git a/bpf/netd/BpfHandler.cpp b/bpf/netd/BpfHandler.cpp
index 97e40ee..7e5e9a8 100644
--- a/bpf/netd/BpfHandler.cpp
+++ b/bpf/netd/BpfHandler.cpp
@@ -114,16 +114,6 @@ static Result<void> initPrograms(const char* cg2_path) {
     // This code was mainlined in T, so this should be trivially satisfied.
     if (!isAtLeastT) return Error() << "S- platform is unsupported";
 
-    // S requires eBPF support which was only added in 4.9, so this should be satisfied.
-    if (!isAtLeastKernelVersion(4, 9)) {
-        return Error() << "kernel version < 4.9.0 is unsupported";
-    }
-
-    // U bumps the kernel requirement up to 4.14
-    if (isAtLeastU && !isAtLeastKernelVersion(4, 14)) {
-        return Error() << "U+ platform with kernel version < 4.14.0 is unsupported";
-    }
-
     // U mandates this mount point (though it should also be the case on T)
     if (isAtLeastU && !!strcmp(cg2_path, "/sys/fs/cgroup")) {
         return Error() << "U+ platform with cg2_path != /sys/fs/cgroup is unsupported";
