From bc9b608650b7212a9c4226ddfcd60bd6d5915176 Mon Sep 17 00:00:00 2001
From: yvanliang <yvan6liang@outlook.com>
Date: Fri, 9 Oct 2026 15:43:25 +0800
Subject: [PATCH 06/18] GSI Android 17 compatibility:
 0006-More-bpf-errors-ignore-there-are-some-4.14-without-t.patch

Change-Id: I880508bd38e86eaa5c1063cb1b6a8e025b1e8e90
---
 bpf/loader/NetBpfLoad.cpp | 3 +--
 1 file changed, 1 insertion(+), 2 deletions(-)

diff --git a/bpf/loader/NetBpfLoad.cpp b/bpf/loader/NetBpfLoad.cpp
index 21918ff..25cc01a 100644
--- a/bpf/loader/NetBpfLoad.cpp
+++ b/bpf/loader/NetBpfLoad.cpp
@@ -1740,8 +1740,7 @@ static int doLoad(char** argv, char * const envp[]) {
         // but we need 0 (enabled)
         // (this writeFile is known to fail on at least 4.19, but always defaults to 0 on
         // pre-5.13, on 5.13+ it depends on CONFIG_BPF_UNPRIV_DEFAULT_OFF)
-        if (!writeFile("/proc/sys/kernel/unprivileged_bpf_disabled", "0\n") &&
-            isAtLeastKernelVersion(5, 13)) {
+        if (!writeFile("/proc/sys/kernel/unprivileged_bpf_disabled", "0\n")) {
             failed = true;
         }
     }
