diff --git a/service-t/src/com/android/server/net/NetworkStatsFactory.java b/service-t/src/com/android/server/net/NetworkStatsFactory.java
index 7d48b71..43a9b19 100644
--- a/service-t/src/com/android/server/net/NetworkStatsFactory.java
+++ b/service-t/src/com/android/server/net/NetworkStatsFactory.java
@@ -253,6 +253,21 @@ public class NetworkStatsFactory {
             // Take a reference. If this gets swapped out, we still have the old reference.
             final UnderlyingNetworkInfo[] vpnArray = mUnderlyingNetworkInfos;
 
+            // qtaguid returns cumulative snapshots, unlike consumed BPF deltas.
+            // Accumulating this snapshot would double count traffic on every poll.
+            if (nativeIsLegacyStatsBackend()) {
+                final NetworkStats snapshot = mDeps.getNetworkStatsDetail();
+                mPersistSnapshot = snapshot.clone();
+                snapshot.apply464xlatAdjustments(mStackedIfaces);
+                for (UnderlyingNetworkInfo info : vpnArray) {
+                    snapshot.migrateTun(info.getOwnerUid(), info.getInterface(),
+                            info.getUnderlyingInterfaces());
+                    snapshot.filterDebugEntries();
+                }
+                mTunAnd464xlatAdjustedStats = snapshot;
+                return snapshot.filteredClone(limitUid, limitIfaces, limitTag);
+            }
+
             requestSwapActiveStatsMapLocked();
             // Stats are always read from the inactive map, so they must be read after the
             // swap
@@ -370,6 +385,8 @@ public class NetworkStatsFactory {
      * are expected to monotonically increase since device boot.
      */
     @VisibleForTesting
+    public static native boolean nativeIsLegacyStatsBackend();
+
     public static native int nativeReadNetworkStatsDetail(NetworkStats stats);
 
     @VisibleForTesting
