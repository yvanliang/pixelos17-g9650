 #include <inttypes.h>
+#include <stdio.h>
+#include <unistd.h>
+#include <sys/utsname.h>
+#include "android-base/properties.h"
 #include <net/if.h>
 #include <string.h>
 #include <unordered_set>
@@ -40,6 +44,89 @@ namespace bpf {
 
 using base::Result;
 
+// G9650/4.9 only: consume real kernel qtaguid counters, never fabricated zeros.
+bool isLegacyQtaguidBackend() {
+    static const bool legacy = [] {
+        struct utsname kernel = {};
+        return base::GetProperty("ro.boot.bootloader", "").rfind("G9650", 0) == 0
+                && uname(&kernel) == 0 && strncmp(kernel.release, "4.9.", 4) == 0
+                && access("/proc/net/xt_qtaguid/stats", R_OK) == 0;
+    }();
+    return legacy;
+}
+
+static int parseLegacyDetail(std::vector<stats_line>* lines) {
+    FILE* file = fopen("/proc/net/xt_qtaguid/stats", "re");
+    if (!file) return -errno;
+    char buffer[1024];
+    if (!fgets(buffer, sizeof(buffer), file)
+            || strncmp(buffer, "idx iface acct_tag_hex", 22) != 0) {
+        fclose(file); return -EINVAL;
+    }
+    while (fgets(buffer, sizeof(buffer), file)) {
+        stats_line line = {};
+        unsigned index;
+        uint64_t tag;
+        const int fields = sscanf(buffer, "%u %31s %" SCNx64 " %u %u %" SCNd64
+                " %" SCNd64 " %" SCNd64 " %" SCNd64, &index, line.iface, &tag,
+                &line.uid, &line.set, &line.rxBytes, &line.rxPackets,
+                &line.txBytes, &line.txPackets);
+        if (fields != 9 || line.rxBytes < 0 || line.txBytes < 0
+                || line.rxPackets < 0 || line.txPackets < 0) {
+            fclose(file); return -EINVAL;
+        }
+        line.tag = tag >> 32;
+        lines->push_back(line);
+    }
+    const int result = ferror(file) ? -EIO : 0;
+    fclose(file);
+    if (result == 0) groupNetworkStats(*lines);
+    return result;
+}
+
+static int parseLegacyDev(std::vector<stats_line>* lines) {
+    FILE* file = fopen("/proc/net/xt_qtaguid/iface_stat_all", "re");
+    if (!file) return -errno;
+    char buffer[512];
+    while (fgets(buffer, sizeof(buffer), file)) {
+        stats_line line = {};
+        unsigned active;
+        int64_t rxBytes, rxPackets, txBytes, txPackets;
+        const int fields = sscanf(buffer, "%31s %u %" SCNd64 " %" SCNd64
+                " %" SCNd64 " %" SCNd64 " %" SCNd64 " %" SCNd64
+                " %" SCNd64 " %" SCNd64, line.iface, &active, &line.rxBytes,
+                &line.rxPackets, &line.txBytes, &line.txPackets,
+                &rxBytes, &rxPackets, &txBytes, &txPackets);
+        if (fields != 10) { fclose(file); return -EINVAL; }
+        // iface_stat_all stores inactive totals plus the currently active counters.
+        if (active & 1) {
+            line.rxBytes += rxBytes; line.rxPackets += rxPackets;
+            line.txBytes += txBytes; line.txPackets += txPackets;
+        }
+        line.uid = UID_ALL; line.set = SET_ALL; line.tag = TAG_NONE;
+        lines->push_back(line);
+    }
+    const int result = ferror(file) ? -EIO : 0;
+    fclose(file);
+    return result;
+}
+
+static int getLegacyStats(const char* iface, int64_t uid, StatsValue* stats) {
+    std::vector<stats_line> lines;
+    const int result = uid < 0 ? parseLegacyDev(&lines) : parseLegacyDetail(&lines);
+    if (result != 0) return result;
+    *stats = {};
+    for (const auto& line : lines) {
+        if (iface && strcmp(line.iface, iface) != 0) continue;
+        // tag zero already includes all tagged traffic for this UID.
+        if (uid >= 0 && (line.uid != uid || line.tag != TAG_NONE)) continue;
+        stats->rxBytes += line.rxBytes; stats->rxPackets += line.rxPackets;
+        stats->txBytes += line.txBytes; stats->txPackets += line.txPackets;
+    }
+    return 0;
+}
+
+
 BpfMapRW<uint32_t, IfaceValue>& getIfaceIndexNameMap() {
     constexpr bool exclusive = true;
     static BpfMapRW<uint32_t, IfaceValue> ifaceIndexNameMap(IFACE_INDEX_NAME_MAP_PATH, exclusive);
@@ -93,6 +180,7 @@ static Result<IfaceValue> ifindex2name(const uint32_t ifindex) {
 }
 
 void bpfRegisterIface(const char* iface) {
+    if (isLegacyQtaguidBackend()) return;
     if (!iface) return;
     if (strlen(iface) >= sizeof(IfaceValue)) return;
     uint32_t ifindex = if_nametoindex(iface);
@@ -115,6 +203,7 @@ int bpfGetUidStatsInternal(uid_t uid, StatsValue* stats,
 }
 
 int bpfGetUidStats(uid_t uid, StatsValue* stats) {
+    if (isLegacyQtaguidBackend()) return getLegacyStats(nullptr, uid, stats);
     static BpfMapRO<uint32_t, StatsValue> appUidStatsMap(APP_UID_STATS_MAP_PATH);
     return bpfGetUidStatsInternal(uid, stats, appUidStatsMap);
 }
@@ -170,6 +259,7 @@ int bpfGetIfaceStatsInternal(const char* iface, StatsValue* stats,
 }
 
 int bpfGetIfaceStats(const char* iface, StatsValue* stats) {
+    if (isLegacyQtaguidBackend()) return getLegacyStats(iface, -1, stats);
     return bpfGetIfaceStatsInternal(iface, stats, getIfaceStatsMap(), ifindex2name);
 }
 
@@ -185,6 +275,11 @@ int bpfGetIfIndexStatsInternal(uint32_t ifindex, StatsValue* stats,
 }
 
 int bpfGetIfIndexStats(int ifindex, StatsValue* stats) {
+    if (isLegacyQtaguidBackend()) {
+        char name[IF_NAMESIZE];
+        if (!if_indextoname(ifindex, name)) return -errno;
+        return getLegacyStats(name, -1, stats);
+    }
     return bpfGetIfIndexStatsInternal(ifindex, stats, getIfaceStatsMap());
 }
 
@@ -253,6 +348,7 @@ int parseBpfNetworkStatsDetailInternal(std::vector<stats_line>& lines,
 }
 
 int parseBpfNetworkStatsDetail(std::vector<stats_line>* lines) {
+    if (isLegacyQtaguidBackend()) return parseLegacyDetail(lines);
     static BpfMapRO<uint32_t, uint32_t> configurationMap(CONFIGURATION_MAP_PATH);
     static BpfMap<StatsKey, StatsValue> statsMapA(STATS_MAP_A_PATH);
     static BpfMap<StatsKey, StatsValue> statsMapB(STATS_MAP_B_PATH);
@@ -318,6 +414,7 @@ int parseBpfNetworkStatsDevInternal(std::vector<stats_line>& lines,
 }
 
 int parseBpfNetworkStatsDev(std::vector<stats_line>* lines) {
+    if (isLegacyQtaguidBackend()) return parseLegacyDev(lines);
     return parseBpfNetworkStatsDevInternal(*lines, getIfaceStatsMap(), ifindex2name);
 }
 
