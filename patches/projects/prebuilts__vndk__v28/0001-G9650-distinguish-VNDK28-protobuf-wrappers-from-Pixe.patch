From 9468bb2776c75695eed914ee0a5754e5dd4ddafd Mon Sep 17 00:00:00 2001
From: yvanliang <yvan6liang@outlook.com>
Date: Fri, 9 Oct 2026 16:12:05 +0800
Subject: [PATCH 1/3] G9650: distinguish VNDK28 protobuf wrappers from PixelOS
 VNDK29 compatibility

Change-Id: I64a49623878b5a21e18fb46ff29c31a7c294c45d
---
 Android.bp | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/Android.bp b/Android.bp
index 683c24c..152657c 100644
--- a/Android.bp
+++ b/Android.bp
@@ -131,7 +131,7 @@ prebuilt_etc {
 
 // Defining prebuilt libraries for the compatibility of old vendor modules
 cc_prebuilt_library_shared {
-    name: "libprotobuf-cpp-lite-vendorcompat",
+    name: "libprotobuf-cpp-lite-vndk28-vendorcompat",
     stem: "libprotobuf-cpp-lite",
     vendor: true,
     // These are already stripped, and restripping them just issues diagnostics.
@@ -163,7 +163,7 @@ cc_prebuilt_library_shared {
 }
 
 cc_prebuilt_library_shared {
-    name: "libprotobuf-cpp-full-vendorcompat",
+    name: "libprotobuf-cpp-full-vndk28-vendorcompat",
     stem: "libprotobuf-cpp-full",
     vendor: true,
     // These are already stripped, and restripping them just issues diagnostics.
