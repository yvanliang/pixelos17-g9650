From 5022ffa12d9fcc7d3cc819504d7fc934ad717638 Mon Sep 17 00:00:00 2001
From: yvanliang <42460514+yvanliang@users.noreply.github.com>
Date: Thu, 15 Oct 2026 20:10:59 +0800
Subject: [PATCH 22/23] G9650: delegate charger shutdown and restart to init

Change-Id: I411fca9ab5f58f012d9a63e611d2679a65107d83
---
 healthd/healthd_mode_charger.cpp | 31 ++++++++++++++++++++++++++++---
 1 file changed, 28 insertions(+), 3 deletions(-)

diff --git a/healthd/healthd_mode_charger.cpp b/healthd/healthd_mode_charger.cpp
index 8064be0..6c28a2d 100644
--- a/healthd/healthd_mode_charger.cpp
+++ b/healthd/healthd_mode_charger.cpp
@@ -41,6 +41,7 @@
 #include <sys/socket.h>
 
 #include <cutils/android_get_control_file.h>
+#include <cutils/android_reboot.h>
 #include <cutils/klog.h>
 #include <cutils/misc.h>
 #include <cutils/properties.h>
@@ -99,6 +100,30 @@ char* locale;
 
 namespace android {
 
+// The FVA4 charger must release its display/input handles before rebooting.
+// Delegate to init, which also passes a normal non-null reboot reason to Samsung.
+static void RebootCharger(int command) {
+    char bootloader[PROPERTY_VALUE_MAX] = {};
+    property_get("ro.boot.bootloader", bootloader, "");
+    if (strncmp(bootloader, "G9650", 5) != 0) {
+        reboot(command);
+        return;
+    }
+    const bool poweroff = command == RB_POWER_OFF;
+    const char* action = poweroff ? "shutdown,userrequested" : "reboot,userrequested";
+    LOGW("G9650Charger: requesting init %s\n", action);
+    int fd = open("/dev/g9650-charger-cache/g9650-charger-action.log",
+                  O_WRONLY | O_CREAT | O_APPEND | O_CLOEXEC, 0600);
+    if (fd >= 0) {
+        dprintf(fd, "request %s uid=%d\n", action, static_cast<int>(getuid()));
+        fsync(fd);
+        close(fd);
+    }
+    int result = android_reboot(poweroff ? ANDROID_RB_POWEROFF : ANDROID_RB_RESTART2,
+                                0, "userrequested");
+    if (result != 0) LOGE("G9650Charger: init request failed result=%d errno=%d\n", result, errno);
+}
+
 #if defined(__ANDROID_VNDK__)
 static constexpr const char* vendor_animation_desc_path =
         "/vendor/etc/res/values/charger/animation.txt";
@@ -516,7 +541,7 @@ void Charger::ProcessKey(int code, int64_t now) {
                 } else {
                     if (batt_anim_.cur_level >= boot_min_cap_) {
                         LOGW("[%" PRId64 "] rebooting\n", now);
-                        reboot(RB_AUTOBOOT);
+                        RebootCharger(RB_AUTOBOOT);
                     } else {
                         LOGV("[%" PRId64
                              "] ignore power-button press, battery level "
@@ -594,7 +619,7 @@ void Charger::HandlePowerSupplyState(int64_t now) {
                  now, (int64_t)timer_shutdown, next_pwr_check_);
         } else if (now >= next_pwr_check_) {
             LOGW("[%" PRId64 "] shutting down\n", now);
-            reboot(RB_POWER_OFF);
+            RebootCharger(RB_POWER_OFF);
         } else {
             /* otherwise we already have a shutdown timer scheduled */
         }
@@ -648,7 +673,7 @@ void Charger::OnHealthInfoChanged(const ChargerHealthInfo& health_info) {
                 property_set("sys.boot_from_charger_mode", "1");
             } else {
                 LOGW("Battery SOC = %d%%, Automatically rebooting\n", health_info_.battery_level);
-                reboot(RB_AUTOBOOT);
+                RebootCharger(RB_AUTOBOOT);
             }
         }
     }
