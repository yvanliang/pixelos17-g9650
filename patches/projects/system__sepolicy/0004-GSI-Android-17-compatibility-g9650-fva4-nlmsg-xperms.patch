+++ b/private/auditctl.te
@@ -21,4 +21,6 @@ allow auditctl self:netlink_audit_socket create_socket_perms_no_ioctl;
 allow auditctl self:netlink_audit_socket nlmsg_write;
 # For kernel >= 6.13
 allow auditctl self:netlink_audit_socket nlmsg;
