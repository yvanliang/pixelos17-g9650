 allow dumpstate tombstone_data_file:dir r_dir_perms;
@@ -543,7 +547,9 @@ allow dumpstate self:netlink_xfrm_socket create_socket_perms_no_ioctl;
 allow dumpstate self:netlink_xfrm_socket nlmsg_read;
 # For kernel >= 6.13
