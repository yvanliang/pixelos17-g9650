diff --git a/private/net.te b/private/net.te
index 046d554..75548ea 100644
--- a/private/net.te
+++ b/private/net.te
@@ -33,7 +33,9 @@ allow { netdomain -pcc_component } self:{ icmp_socket udp_socket rawip_socket }
