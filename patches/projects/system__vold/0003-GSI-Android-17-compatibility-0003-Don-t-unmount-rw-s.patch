 VolumeManager.cpp | 1 +
 1 file changed, 1 insertion(+)

diff --git a/VolumeManager.cpp b/VolumeManager.cpp
index 2b42e25..33efa75 100644
--- a/VolumeManager.cpp
+++ b/VolumeManager.cpp
@@ -1074,6 +1074,7 @@ int VolumeManager::unmountAll() {
     while ((mentry = getmntent(fp)) != NULL) {
