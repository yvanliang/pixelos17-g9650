From 13efdb843476d463dcf2f6c4a716766a8ee12fa9 Mon Sep 17 00:00:00 2001
From: yvanliang <yvan6liang@outlook.com>
Date: Fri, 9 Oct 2026 15:50:55 +0800
Subject: [PATCH 2/3] G9650: use the original Google GMS APK on the EXT4-only
 legacy kernel

---
 common/Android.bp              | 18 ++++++++++++------
 common/common-vendor.mk        |  3 +--
 common/g9650-legacy/.gitignore |  1 +
 3 files changed, 14 insertions(+), 8 deletions(-)
 create mode 100644 common/g9650-legacy/.gitignore

diff --git a/common/Android.bp b/common/Android.bp
index 8c2c511..01a1b92 100644
--- a/common/Android.bp
+++ b/common/Android.bp
@@ -48,13 +48,19 @@ prebuilt_apex {
     filename: "com.google.android.extservices.apex",
 }
 
-prebuilt_apex {
-    name: "com.google.android.gmssystem.prodvic",
-    apps: ["PrebuiltGmsCoreVic"],
-    product_specific: true,
+// G9650: original signed APK; the upstream APEX payload is EROFS.
+android_app_import {
+    name: "PrebuiltGmsCoreVic",
     owner: "pixel/gms",
-    src: "proprietary/system/apex/com.google.android.gmssystem.prodvic.apex",
-    filename: "com.google.android.gmssystem.prodvic.apex",
+    apk: "g9650-legacy/PrebuiltGmsCoreVic.apk",
+    preprocessed: true,
+    presigned: true,
+    dex_preopt: { enabled: false },
+    privileged: true,
+    product_specific: true,
+    relative_install_path: "PrebuiltGmsCore",
+    install_path_skip_module_dir: true,
+    filename: "PrebuiltGmsCore.apk",
 }
 
 android_app_import {
diff --git a/common/common-vendor.mk b/common/common-vendor.mk
index 89726d6..2513395 100644
--- a/common/common-vendor.mk
+++ b/common/common-vendor.mk
@@ -17,7 +17,6 @@ PRODUCT_COPY_FILES += \
     vendor/pixel/gms/common/proprietary/product/etc/preferred-apps/google.xml:$(TARGET_COPY_OUT_PRODUCT)/etc/preferred-apps/google.xml \
     vendor/pixel/gms/common/proprietary/product/etc/security/fsverity/gms_fsverity_cert.der:$(TARGET_COPY_OUT_PRODUCT)/etc/security/fsverity/gms_fsverity_cert.der \
     vendor/pixel/gms/common/proprietary/product/etc/security/fsverity/play_store_fsi_cert.der:$(TARGET_COPY_OUT_PRODUCT)/etc/security/fsverity/play_store_fsi_cert.der \
-    vendor/pixel/gms/common/proprietary/product/etc/sysconfig/allowed_apex_com.google.android.gmssystem.xml:$(TARGET_COPY_OUT_PRODUCT)/etc/sysconfig/allowed_apex_com.google.android.gmssystem.xml \
     vendor/pixel/gms/common/proprietary/product/etc/sysconfig/contextual_search.xml:$(TARGET_COPY_OUT_PRODUCT)/etc/sysconfig/contextual_search.xml \
     vendor/pixel/gms/common/proprietary/product/etc/sysconfig/game_service.xml:$(TARGET_COPY_OUT_PRODUCT)/etc/sysconfig/game_service.xml \
     vendor/pixel/gms/common/proprietary/product/etc/sysconfig/google-hiddenapi-package-whitelist.xml:$(TARGET_COPY_OUT_PRODUCT)/etc/sysconfig/google-hiddenapi-package-whitelist.xml \
@@ -121,7 +120,7 @@ PRODUCT_COPY_FILES += \
 
 PRODUCT_PACKAGES += \
     com.google.android.extservices \
-    com.google.android.gmssystem.prodvic \
+    PrebuiltGmsCoreVic \
     GoogleExtShared \
     GooglePrintRecommendationService \
     DocumentsUIGoogle \
diff --git a/common/g9650-legacy/.gitignore b/common/g9650-legacy/.gitignore
new file mode 100644
index 0000000..d146e5c
--- /dev/null
+++ b/common/g9650-legacy/.gitignore
@@ -0,0 +1 @@
+/PrebuiltGmsCoreVic.apk
